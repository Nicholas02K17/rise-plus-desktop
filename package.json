{
  "name": "rise-plus-desktop",
  "productName": "RISE+",
  "version": "1.1.0",
  "description": "RISE+ by CanU Canada for Windows and Linux: opens the live RISE+ app in its own window.",
  "author": "CanU Canada <Nicholas02K17@users.noreply.github.com>",
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:all": "electron-builder --win --linux --publish never"
  },
  "devDependencies": {
    "electron": "^43.7.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "org.canucanada.riseplus",
    "productName": "RISE+",
    "copyright": "CanU Canada",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "error.html",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "buildUniversalInstaller": false,
      "artifactName": "RISE-Plus-Setup-${arch}.${ext}",
      "shortcutName": "RISE+",
      "uninstallDisplayName": "RISE+",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "buildUniversalInstaller": false,
      "artifactName": "RISE-Plus-Portable-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "maintainer": "CanU Canada <Nicholas02K17@users.noreply.github.com>",
      "synopsis": "RISE+ by CanU Canada",
      "artifactName": "RISE-Plus.${ext}",
      "executableName": "rise-plus"
    },
    "deb": {
      "artifactName": "rise-plus.${ext}"
    },
    "publish": null
  }
}
